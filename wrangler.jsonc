{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "todoflare-prod",
	"workers_dev": false,
	"preview_urls": false,
	"account_id": "8818a1fbe40a0fdc63ec6ab52cb62e3b",
	"compatibility_date": "2026-01-01",
	"main": "./src/index.tsx",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"],
	},
	"vars": {
		"READ_ONLY_MODE": "false",
		"AUTO_BACKUP_ENABLED": "false",
		"BACKUP_MAX_COLUMNS": "1000",
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": false,
			"invocation_logs": false,
			"persist": false,
			"head_sampling_rate": 0,
		},
		"traces": {
			"enabled": false,
			"persist": false,
			"head_sampling_rate": 0,
		},
	},
	"kv_namespaces": [
		{
			"binding": "ACCOUNTS",
			"id": "b2a26a39720746e2b67d8a07ee1a2d68",
		},
	],
	"analytics_engine_datasets": [
		{
			"binding": "LIFECYCLE_METRICS",
			"dataset": "todoflare_lifecycle_invariants",
		},
	],
	"r2_buckets": [
		{
			"binding": "BACKUPS",
			"bucket_name": "todoflare-backups",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "COLUMN_ROOM",
				"class_name": "ColumnRoomSql",
			},
			{
				"name": "IDEMPOTENCY_COORDINATOR",
				"class_name": "IdempotencyCoordinatorSql",
			},
			{
				"name": "RATE_LIMIT_COORDINATOR",
				"class_name": "RateLimitCoordinatorSql",
			},
			{
				"name": "ACCOUNT_COORDINATOR",
				"class_name": "AccountCoordinatorSql",
			},
			{
				"name": "PUBLIC_ID_COORDINATOR",
				"class_name": "PublicIdCoordinatorSql",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ColumnRoomSql"],
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["IdempotencyCoordinatorSql", "RateLimitCoordinatorSql"],
		},
		{
			"tag": "v3",
			"new_sqlite_classes": ["AccountCoordinatorSql"],
		},
		{
			"tag": "v4",
			"new_sqlite_classes": ["PublicIdCoordinatorSql"],
		},
	],
	"triggers": {
		"crons": ["0 * * * *"],
	},
	"routes": [
		{
			"pattern": "todo.tamesystems.org",
			"custom_domain": true,
		},
	],
}
