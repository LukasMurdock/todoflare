{
	// The package ships TypeScript source, so it must compile under a consumer's
	// strict settings too. These mirror create-vite's React template.
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"types": [],
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src"]
}
