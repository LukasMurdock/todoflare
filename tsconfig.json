{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "@cloudflare/workers-types"],
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"paths": {
			"@/*": ["./src/*"]
		},
		"skipLibCheck": true
	},
	"exclude": ["test", "e2e", "repos", "docs", "visual"]
}
