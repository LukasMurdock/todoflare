{
  "name": "todoflare",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "pnpm build:e2e && pnpm test:e2e:run",
    "test:e2e:run": "playwright test",
    "build:e2e": "TODOFLARE_E2E=true VITE_E2E_REPLAY_CONTROL=true vite build",
    "test:hosts": "playwright test --config playwright.hosts.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "e2e:reset-state": "node scripts/reset-e2e-state.mjs",
    "e2e:serve": "pnpm e2e:reset-state && wrangler d1 migrations apply AUTH_DB --local --persist-to .wrangler/e2e-state && TODOFLARE_E2E=true vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "typecheck:examples": "tsc -p examples/minimal",
    "check:verification-config": "node scripts/check-verification-config.mjs",
    "check:architecture": "node scripts/check-browser-boundaries.mjs",
    "check:route-literals": "node scripts/check-route-literals.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:board-boundary": "node scripts/analysis/board-boundary.mjs --check",
    "check:board-api": "node scripts/board-api-report.mjs",
    "check:sensitive-url-observability": "node scripts/check-sensitive-url-observability.mjs",
    "lint:hooks": "eslint src packages --max-warnings 0",
    "verify:checks": "pnpm check:verification-config && pnpm check:architecture && pnpm check:route-literals && pnpm check:board-boundary && pnpm check:board-api && pnpm check:sensitive-url-observability && pnpm lint:hooks && pnpm typecheck && pnpm typecheck:test && pnpm typecheck:examples && pnpm test:run",
    "verify:fast": "pnpm verify:checks && pnpm build",
    "verify": "pnpm verify:checks && pnpm build:e2e && pnpm check:bundle-size && pnpm test:e2e:run && pnpm test:hosts",
    "backup:list": "node scripts/backup-admin.mjs list",
    "backup:create": "node scripts/backup-admin.mjs create",
    "backup:restore": "node scripts/backup-admin.mjs restore",
    "backup:restore-account": "node scripts/backup-admin.mjs restore-account",
    "auth:migrate:local": "wrangler d1 migrations apply AUTH_DB --local",
    "auth:migrate:remote": "wrangler d1 migrations apply AUTH_DB --remote",
    "deploy": "pnpm check:sensitive-url-observability && pnpm build:production && node scripts/deploy-production.mjs",
    "build:staging": "node scripts/build-staging.mjs",
    "deploy:staging": "pnpm check:sensitive-url-observability && pnpm build:staging && node scripts/deploy-staging.mjs",
    "auth:migrate:staging": "wrangler d1 migrations apply AUTH_DB --remote --env staging",
    "test:staging": "node scripts/staging-drill.mjs",
    "test:staging:auth": "TODOFLARE_PASSKEY_ORIGIN=https://staging.todo.tamesystems.org playwright test --config playwright.staging.config.ts",
    "build:production": "node scripts/build-production.mjs"
  },
  "dependencies": {
    "@todoflare/board": "workspace:*",
    "@better-auth/passkey": "1.6.24",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/floating": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/link": "^53.3.1",
    "@platejs/list": "^53.1.3",
    "@platejs/markdown": "^53.2.2",
    "@platejs/yjs": "^53.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-toolbar": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@slate-yjs/core": "^1.0.2",
    "@slate-yjs/react": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@xstate/react": "6.1.0",
    "better-auth": "1.6.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.30",
    "lib0": "^0.2.117",
    "lucide-react": "^1.25.0",
    "platejs": "^53.2.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "xstate": "5.32.5",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "8.64.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.1.5",
    "vitest": "~4.1.10",
    "wrangler": "^4.112.0"
  }
}
